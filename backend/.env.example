# Puerto del servidor
PORT=3000

# Base de Datos Relacional (PostgreSQL)
# Si usa Docker, el host es 'postgres'. Si es local, es 'localhost'
DATABASE_URL=postgresql://unab:unab123@localhost:5432/reservas

# Base de Datos NoSQL (MongoDB)
# Si usa Docker, el host es 'mongo'. Si es local, es '127.0.0.1'
MONGO_URI=mongodb://127.0.0.1:27017/reservas_unab

# Autenticación
JWT_SECRET=tu_secreto_super_secreto_y_largo_aqui_12345
JWT_EXPIRES_IN=8h

# API de Correos (Resend)
RESEND_API_KEY=re_tu_api_key_aqui