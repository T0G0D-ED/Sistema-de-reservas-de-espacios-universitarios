# Configuración del backend
PORT=3000
NODE_ENV=development

# Autenticación
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-largo
JWT_EXPIRES_IN=8h

# PostgreSQL (para ejecutar el backend fuera de Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=usuario_local
POSTGRES_PASSWORD=clave_local_postgres
POSTGRES_DB=reservas_db
DATABASE_URL=postgresql://usuario_local:clave_local_postgres@localhost:5432/reservas_db

# MongoDB (para ejecutar el backend fuera de Docker)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=usuario_mongo_local
MONGO_PASSWORD=clave_local_mongo
MONGO_DB=auditoria_db
MONGO_URI=mongodb://usuario_mongo_local:clave_local_mongo@127.0.0.1:27017/auditoria_db?authSource=admin

# Correo de prueba (Resend)
RESEND_API_KEY=reemplazar-por-una-api-key-de-resend
RESEND_TEST_EMAIL=correo-de-prueba@example.com

# URL de la API consumida por el frontend
VITE_API_URL=http://localhost:3000
